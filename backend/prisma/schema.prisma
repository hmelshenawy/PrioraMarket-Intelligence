generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MarketplaceSource {
  id            BigInt         @id @default(autoincrement())
  code          String         @unique
  name          String
  country       String
  baseUrl       String         @map("base_url")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  ingestion_run IngestionRun[]
  listing       Listing[]
  raw_listing   RawListing[]

  @@map("marketplace_source")
}

model IngestionRun {
  id                                               BigInt            @id @default(autoincrement())
  name                                             String            @unique
  marketplaceSourceId                              BigInt            @map("marketplace_source_id")
  marketplace                                      String
  condition                                        String
  make                                             String
  status                                           String
  startedAt                                        DateTime          @map("started_at") @db.Timestamptz(6)
  completedAt                                      DateTime?         @map("completed_at") @db.Timestamptz(6)
  pagesScraped                                     Int               @default(0) @map("pages_scraped")
  listingsExtracted                                Int               @default(0) @map("listings_extracted")
  listingsSkipped                                  Int               @default(0) @map("listings_skipped")
  failuresCount                                    Int               @default(0) @map("failures_count")
  durationMs                                       Int?              @map("duration_ms")
  configSnapshot                                   Json              @default("{}") @map("config_snapshot")
  reportJson                                       Json?             @map("report_json")
  createdAt                                        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  marketplace_source                               MarketplaceSource @relation(fields: [marketplaceSourceId], references: [id], onUpdate: NoAction)
  listing_listing_first_seen_run_idToingestion_run Listing[]         @relation("listing_first_seen_run_idToingestion_run")
  listing_listing_last_seen_run_idToingestion_run  Listing[]         @relation("listing_last_seen_run_idToingestion_run")
  listing_snapshot                                 ListingSnapshot[]
  raw_listing                                      RawListing[]

  @@index([marketplaceSourceId], map: "idx_ingestion_run_marketplace_source_id")
  @@index([marketplace, condition, make], map: "idx_ingestion_run_scope")
  @@map("ingestion_run")
}

model RawListing {
  id                        BigInt            @id @default(autoincrement())
  marketplaceSourceId       BigInt            @map("marketplace_source_id")
  ingestionRunId            BigInt            @map("ingestion_run_id")
  source                    String
  uuid                      String
  rawPayload                Json              @map("raw_payload")
  rawHash                   String            @map("raw_hash")
  adapterVersion            String            @map("adapter_version")
  marketplaceSchemaVersion  String?           @map("marketplace_schema_version")
  marketplacePayloadVersion String?           @map("marketplace_payload_version")
  extractedAt               DateTime          @map("extracted_at") @db.Timestamptz(6)
  createdAt                 DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  listing                   Listing[]
  listing_snapshot          ListingSnapshot[]
  ingestion_run             IngestionRun      @relation(fields: [ingestionRunId], references: [id], onUpdate: NoAction)
  marketplace_source        MarketplaceSource @relation(fields: [marketplaceSourceId], references: [id], onUpdate: NoAction)

  @@index([ingestionRunId], map: "idx_raw_listing_ingestion_run_id")
  @@index([rawHash], map: "idx_raw_listing_raw_hash")
  @@index([source, uuid], map: "idx_raw_listing_source_uuid")
  @@map("raw_listing")
}

model Listing {
  id                                                     BigInt            @id @default(autoincrement())
  marketplaceSourceId                                    BigInt            @map("marketplace_source_id")
  source                                                 String
  uuid                                                   String
  title                                                  String?
  make                                                   String?
  model                                                  String?
  trim                                                   String?
  year                                                   Int?
  price                                                  Decimal?          @db.Decimal(14, 2)
  mileage                                                Int?
  condition                                              String?
  fuelType                                               String?           @map("fuel_type")
  transmission                                           String?
  bodyType                                               String?           @map("body_type")
  regionalSpec                                           String?           @map("regional_spec")
  specs                                                  String?
  color                                                  String?
  vehicleCondition                                       String?           @map("vehicle_condition")
  location                                               String?
  sellerType                                             String?           @map("seller_type")
  url                                                    String?
  status                                                 String            @default("ACTIVE")
  firstSeenAt                                            DateTime          @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt                                             DateTime          @map("last_seen_at") @db.Timestamptz(6)
  firstSeenRunId                                         BigInt            @map("first_seen_run_id")
  lastSeenRunId                                          BigInt            @map("last_seen_run_id")
  currentRawListingId                                    BigInt?           @map("current_raw_listing_id")
  canonicalHash                                          String            @map("canonical_hash")
  normalizationVersion                                   String            @map("normalization_version")
  canonicalizationVersion                                String?           @map("canonicalization_version")
  createdAt                                              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                              DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  raw_listing                                            RawListing?       @relation(fields: [currentRawListingId], references: [id], onUpdate: NoAction)
  ingestion_run_listing_first_seen_run_idToingestion_run IngestionRun      @relation("listing_first_seen_run_idToingestion_run", fields: [firstSeenRunId], references: [id], onUpdate: NoAction)
  ingestion_run_listing_last_seen_run_idToingestion_run  IngestionRun      @relation("listing_last_seen_run_idToingestion_run", fields: [lastSeenRunId], references: [id], onUpdate: NoAction)
  marketplace_source                                     MarketplaceSource @relation(fields: [marketplaceSourceId], references: [id], onUpdate: NoAction)
  listing_snapshot                                       ListingSnapshot[]

  @@unique([source, uuid])
  @@index([canonicalHash], map: "idx_listing_canonical_hash")
  @@index([lastSeenRunId], map: "idx_listing_last_seen_run_id")
  @@index([marketplaceSourceId], map: "idx_listing_marketplace_source_id")
  @@map("listing")
}

model ListingSnapshot {
  id               BigInt       @id @default(autoincrement())
  listingId        BigInt       @map("listing_id")
  ingestionRunId   BigInt       @map("ingestion_run_id")
  rawListingId     BigInt?      @map("raw_listing_id")
  snapshotHash     String       @map("snapshot_hash")
  canonicalPayload Json         @map("canonical_payload")
  changedFields    Json         @default("[]") @map("changed_fields")
  capturedAt       DateTime     @map("captured_at") @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  ingestion_run    IngestionRun @relation(fields: [ingestionRunId], references: [id], onUpdate: NoAction)
  listing          Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  raw_listing      RawListing?  @relation(fields: [rawListingId], references: [id], onUpdate: NoAction)

  @@index([ingestionRunId], map: "idx_listing_snapshot_ingestion_run_id")
  @@index([listingId, capturedAt], map: "idx_listing_snapshot_listing_captured")
  @@index([listingId], map: "idx_listing_snapshot_listing_id")
  @@map("listing_snapshot")
}

model yoyo_log {
  id             String    @id @db.VarChar(36)
  migration_hash String?   @db.VarChar(64)
  migration_id   String?   @db.VarChar(255)
  operation      String?   @db.VarChar(10)
  username       String?   @db.VarChar(255)
  hostname       String?   @db.VarChar(255)
  comment        String?   @db.VarChar(255)
  created_at_utc DateTime? @db.Timestamp(6)

  @@map("_yoyo_log")
}

model yoyo_migration {
  migration_hash String    @id @db.VarChar(64)
  migration_id   String?   @db.VarChar(255)
  applied_at_utc DateTime? @db.Timestamp(6)

  @@map("_yoyo_migration")
}

model yoyo_version {
  version          Int       @id
  installed_at_utc DateTime? @db.Timestamp(6)

  @@map("_yoyo_version")
}

model VehicleReferenceCatalog {
  id                 BigInt    @id @default(autoincrement())
  market             String    @default("global")
  makeKey            String    @map("make_key")
  makeDisplay        String    @map("make_display")
  modelKey           String    @map("model_key")
  modelDisplay       String    @map("model_display")
  generation         String?
  bodyCode           String?   @map("body_code")
  startYear          Int?      @map("start_year")
  endYear            Int?      @map("end_year")
  faceliftStartYear  Int?      @map("facelift_start_year")
  faceliftEndYear    Int?      @map("facelift_end_year")
  aliases            Json      @default("{}")
  confidence         String    @default("manual")
  sourceFile         String?   @map("source_file")
  sourceRowHash      String?   @map("source_row_hash")
  lastSyncedAt       DateTime? @map("last_synced_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([market, makeKey, modelKey, generation, bodyCode], map: "uq_vehicle_reference_catalog_market_identity")
  @@index([market, makeKey, modelKey], map: "idx_vehicle_reference_catalog_market_make_model")
  @@index([market, makeKey, modelKey, startYear, endYear], map: "idx_vehicle_reference_catalog_market_make_model_years")
  @@map("vehicle_reference_catalog")
}

model yoyo_lock {
  locked Int       @id @default(1)
  ctime  DateTime? @db.Timestamp(6)
  pid    Int
}
