generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model RawListing {
  id                        BigInt    @id @default(autoincrement())
  source                    String
  uuid                      String
  rawPayload                Json      @map("raw_payload")
  rawHash                   String    @map("raw_hash")
  adapterVersion            String    @map("adapter_version")
  marketplaceSchemaVersion  String?   @map("marketplace_schema_version")
  marketplacePayloadVersion String?   @map("marketplace_payload_version")
  extractedAt               DateTime  @map("extracted_at") @db.Timestamptz(6)
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  listing                   Listing[]

  @@index([rawHash], map: "idx_raw_listing_raw_hash")
  @@index([source, uuid], map: "idx_raw_listing_source_uuid")
  @@map("raw_listing")
}

model Listing {
  id                      BigInt      @id @default(autoincrement())
  source                  String
  uuid                    String
  title                   String?
  make                    String?
  model                   String?
  trim                    String?
  year                    Int?
  price                   Decimal?    @db.Decimal(14, 2)
  mileage                 Int?
  condition               String?
  location                String?
  sellerType              String?     @map("seller_type")
  url                     String?
  status                  String      @default("ACTIVE")
  firstSeenAt             DateTime    @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt              DateTime    @map("last_seen_at") @db.Timestamptz(6)
  currentRawListingId     BigInt?     @map("current_raw_listing_id")
  canonicalHash           String      @map("canonical_hash")
  normalizationVersion    String      @map("normalization_version")
  createdAt               DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)
  fuelType                String?     @map("fuel_type")
  transmission            String?
  bodyType                String?     @map("body_type")
  regionalSpec            String?     @map("regional_spec")
  specs                   String?
  color                   String?
  vehicleCondition        String?     @map("vehicle_condition")
  canonicalizationVersion String?     @map("canonicalization_version")
  raw_listing             RawListing? @relation(fields: [currentRawListingId], references: [id], onUpdate: NoAction)
  marketplaceSourceId     BigInt?             @map("marketplace_source_id")
  firstSeenRunId          BigInt?             @map("first_seen_run_id")
  lastSeenRunId           BigInt?             @map("last_seen_run_id")
  marketplaceSource       MarketplaceSource?  @relation(fields: [marketplaceSourceId], references: [id])
  snapshots               ListingSnapshot[]
  @@unique([source, uuid])
  @@index([canonicalHash], map: "idx_listing_canonical_hash")
  @@index([make, model, trim, fuelType, transmission, bodyType, sellerType, condition], map: "idx_listing_canonical_categoricals")
  @@index([make, model], map: "idx_listing_make_model")
  @@map("listing")
}

model yoyo_log {
  id             String    @id @db.VarChar(36)
  migration_hash String?   @db.VarChar(64)
  migration_id   String?   @db.VarChar(255)
  operation      String?   @db.VarChar(10)
  username       String?   @db.VarChar(255)
  hostname       String?   @db.VarChar(255)
  comment        String?   @db.VarChar(255)
  created_at_utc DateTime? @db.Timestamp(6)

  @@map("_yoyo_log")
}

model yoyo_migration {
  migration_hash String    @id @db.VarChar(64)
  migration_id   String?   @db.VarChar(255)
  applied_at_utc DateTime? @db.Timestamp(6)

  @@map("_yoyo_migration")
}

model yoyo_version {
  version          Int       @id
  installed_at_utc DateTime? @db.Timestamp(6)

  @@map("_yoyo_version")
}

model VehicleReferenceCatalog {
  id                BigInt    @id @default(autoincrement())
  market            String    @default("global")
  makeKey           String    @map("make_key")
  makeDisplay       String    @map("make_display")
  modelKey          String    @map("model_key")
  modelDisplay      String    @map("model_display")
  generation        String?
  bodyCode          String?   @map("body_code")
  startYear         Int?      @map("start_year")
  endYear           Int?      @map("end_year")
  faceliftStartYear Int?      @map("facelift_start_year")
  faceliftEndYear   Int?      @map("facelift_end_year")
  aliases           Json      @default("{}")
  confidence        String    @default("manual")
  sourceFile        String?   @map("source_file")
  sourceRowHash     String?   @map("source_row_hash")
  lastSyncedAt      DateTime? @map("last_synced_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([market, makeKey, modelKey, generation, bodyCode], map: "uq_vehicle_reference_catalog_market_identity")
  @@index([market, makeKey, modelKey], map: "idx_vehicle_reference_catalog_market_make_model")
  @@index([market, makeKey, modelKey, startYear, endYear], map: "idx_vehicle_reference_catalog_market_make_model_years")
  @@index([aliases], map: "idx_vehicle_reference_catalog_aliases_gin", type: Gin)
  @@map("vehicle_reference_catalog")
}

model yoyo_lock {
  locked Int       @id @default(1)
  ctime  DateTime? @db.Timestamp(6)
  pid    Int
}

model vehicle_generation_catalog {
  id                  BigInt   @id @default(autoincrement())
  slug                String   @unique(map: "uq_vehicle_generation_catalog_slug")
  make_key            String
  model_key           String
  generation          String
  body_code           String?
  marketing_name      String?
  start_year          Int
  end_year            Int?
  facelift_start_year Int?
  facelift_end_year   Int?
  aliases             Json     @default("[]")
  confidence          String   @default("manual")
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @db.Timestamptz(6)
  market              String   @default("global")

  @@unique([market, make_key, model_key, generation, body_code], map: "uq_vehicle_generation_catalog_market_identity")
  @@index([market, make_key, model_key], map: "idx_vehicle_generation_catalog_market_make_model")
  @@index([market, make_key, model_key, start_year, end_year], map: "idx_vehicle_generation_catalog_market_make_model_years")
}

model MarketplaceSource {
  id        BigInt    @id @default(autoincrement())
  slug      String    @unique
  name      String?
  baseUrl   String?   @map("base_url")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  listings  Listing[]

  @@map("marketplace_source")
}

model ListingSnapshot {
  id               BigInt   @id @default(autoincrement())
  listingId        BigInt   @map("listing_id")
  capturedAt       DateTime @map("captured_at") @db.Timestamptz(6)
  canonicalPayload Json     @map("canonical_payload")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  listing          Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, capturedAt], map: "idx_listing_snapshot_listing_captured")
  @@map("listing_snapshot")
}