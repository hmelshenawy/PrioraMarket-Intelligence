# PrioraMarket Frontend — environment configuration
# Feature 004 requires no secrets. Copy to .env.local and adjust.

# REQUIRED: base URL of the Feature 003 Backend Search API (no trailing slash).
# Local development default is applied only when this variable is missing in dev.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# OPTIONAL: public site URL used for canonical URLs, OpenGraph, and sitemap.
# NEXT_PUBLIC_SITE_URL=https://prioramarket.example

# OPTIONAL: robots indexing toggle. Set to "false" to discourage indexing (e.g. staging).
# NEXT_PUBLIC_ALLOW_INDEXING=true

# OPTIONAL: backend health polling interval in milliseconds.
# NEXT_PUBLIC_HEALTH_POLLING_INTERVAL=30000