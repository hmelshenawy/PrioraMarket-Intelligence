# PrioraMarket Intelligence — Data Ingestion Foundation
# Copy this file to .env and fill in real values. Never commit .env.

# ---- Marketplace (Dubizzle via Algolia) ----
ALGOLIA_APP_ID=your_algolia_app_id
ALGOLIA_API_KEY=your_algolia_api_key
ALGOLIA_INDEX=by_added_desc_motors.com
ALGOLIA_URL=https://YOUR_APP_ID-dsn.algolia.net/1/indexes/*/queries
HITS_PER_PAGE=20
MAX_PAGES=500

# ---- Output ----
OUTPUT_DIR=./data/dubizzle

# ---- Retry / rate limiting / timeout ----
RETRY_ATTEMPTS=3
RETRY_BACKOFF=1.5
RATE_LIMIT_MIN_SECONDS=0.3
RATE_LIMIT_MAX_SECONDS=0.8
REQUEST_TIMEOUT_SECONDS=15

# ---- Normalization ----
NORMALIZATION_VERSION=norm-1

# ---- Feature flags (operational control / debugging) ----
ENABLE_VALIDATION=true
ENABLE_CANONICALIZATION=true
ENABLE_REPLAY=true
ENABLE_STRUCTURED_LOGGING=true
ENABLE_CSV_STORAGE=true

# ---- Feature 002: Storage backend ----
# Supported values: csv, in-memory, postgres. The default runtime behavior is csv.
STORAGE_BACKEND=csv

# ---- Feature 002: PostgreSQL/Supabase ----
# Required only when STORAGE_BACKEND=postgres. Use non-secret placeholders here;
# put real credentials in .env or your deployment secret manager.
DATABASE_URL=postgres://user:password@localhost:5432/prioramarket
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT=10
